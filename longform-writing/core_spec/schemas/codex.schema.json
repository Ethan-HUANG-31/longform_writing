{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "scope", "always_include", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["global", "style", "character", "location", "object", "rule_lore"]
          },
          "scope": {
            "type": "string",
            "enum": ["global", "relevant", "manual"]
          },
          "always_include": { "type": "boolean" },
          "description": { "type": "string" },
          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
